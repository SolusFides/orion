@using SmartDisplay.Shared.Models.Templates
@inject NavigationManager Navigation

<article class="template-card">
    <div class="template-head">
        <div>
            <h3>@Template.Name</h3>
            <div class="template-id">@Template.Id</div>
        </div>
        <StatusBadge Text="@TemplateThemes.GetDisplayName(Template.Config.Theme)" Variant="neutral" />
    </div>

    <div class="template-grid">
        <div>
            <span>Сетка</span>
            <strong>@TemplateLayouts.GetDisplayName(Template.Config.Layout)</strong>
        </div>
        <div>
            <span>Виджеты</span>
            <strong>@Widgets.Count</strong>
        </div>
    </div>

    <div class="widget-tags">
        @foreach (var widget in Widgets)
        {
            <span>@widget.DisplayTitle</span>
        }
    </div>

    <div class="template-actions">
        <button type="button" @onclick="Edit">Редактировать</button>
        <button type="button" class="secondary" @onclick="Preview">Предпросмотр</button>
        <button type="button" class="danger" @onclick="DeleteAsync">Удалить</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public TemplateDto Template { get; set; } = new();
    [Parameter] public EventCallback<string> OnDeleteRequested { get; set; }

    private List<TemplateWidgetDto> Widgets => Template.Config.GetEffectiveWidgets();

    private void Edit() => Navigation.NavigateTo($"/templates/{Template.Id}/edit");
    private void Preview() => Navigation.NavigateTo($"/templates/{Template.Id}/preview");

    private async Task DeleteAsync()
    {
        if (OnDeleteRequested.HasDelegate)
        {
            await OnDeleteRequested.InvokeAsync(Template.Id);
        }
    }
}
