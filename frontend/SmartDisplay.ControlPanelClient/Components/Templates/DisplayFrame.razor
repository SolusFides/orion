<div class="display-frame @FrameClass">
    <div class="display-frame__device">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Size { get; set; } = "default";

    private string FrameClass => string.IsNullOrWhiteSpace(Size)
        ? "display-frame--default"
        : $"display-frame--{Size}";
}
