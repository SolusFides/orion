@page "/dashboard"

@using SmartDisplay.ControlPanelClient.Models.Dashboard
@using SmartDisplay.ControlPanelClient.Services.Auth
@using SmartDisplay.ControlPanelClient.Services.Dashboard

@inject AuthState AuthState
@inject IDashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Главная | Умный дисплей ЖК</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <div class="auth-required">
        <h1>Нужен вход</h1>
        <p>Для работы с панелью управления сначала авторизуйтесь.</p>
        <button type="button" @onclick="GoToLogin">Перейти ко входу</button>
    </div>
}
else if (summary is null)
{
    <div class="dashboard-loading">Загрузка сводки...</div>
}
else
{
    <AppPageHeader
        Kicker="Главная"
        Title="Панель управления УК"
        Subtitle="Сводка по экранам, шаблонам и режиму чрезвычайных ситуаций.">
        <button type="button" class="primary-action" @onclick="CreateTemplate">Создать шаблон</button>
    </AppPageHeader>

    <section class="stats-grid" aria-label="Основные показатели">
        <DashboardStatCard
            Label="Всего экранов"
            Value="@summary.ScreensTotal.ToString()"
            Hint="Открыть список экранов с группировкой по домам и подъездам."
            Icon="▣"
            Variant="blue"
            Url="/screens" />

        <DashboardStatCard
            Label="С шаблоном"
            Value="@summary.ScreensWithTemplate.ToString()"
            Hint="Посмотреть экраны, на которые уже назначен шаблон."
            Icon="✓"
            Variant="green"
            Url="/screens?view=assigned" />

        <DashboardStatCard
            Label="Шаблоны"
            Value="@summary.TemplatesTotal.ToString()"
            Hint="Перейти к списку шаблонов и настройке виджетов."
            Icon="▦"
            Variant="violet"
            Url="/templates" />

        <DashboardStatCard
            Label="Активные ЧС"
            Value="@summary.ActiveEmergenciesTotal.ToString()"
            Hint="Открыть управление экстренными сообщениями."
            Icon="!"
            Variant="red"
            Url="/emergency" />
    </section>

    <section class="dashboard-sections">
        <DashboardRecentEventList Events="recentEvents" />
    </section>
}

@code {
    private DashboardSummaryDto? summary;
    private List<DashboardRecentEventDto> recentEvents = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            return;
        }

        summary = await DashboardService.GetSummaryAsync();
        recentEvents = await DashboardService.GetRecentEventsAsync();
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");
    private void CreateTemplate() => Navigation.NavigateTo("/templates/create");
}
