@page "/templates/create"
@page "/templates/{TemplateId}/edit"

@using SmartDisplay.ControlPanelClient.Models.Templates
@using SmartDisplay.ControlPanelClient.Services.Auth
@using SmartDisplay.ControlPanelClient.Services.Templates

@inject AuthState AuthState
@inject ITemplatesService TemplatesService
@inject NavigationManager Navigation

<PageTitle>Редактор шаблона | Умный дисплей ЖК</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <EmptyState Icon="!" Title="Нужен вход" Text="Авторизуйтесь, чтобы редактировать шаблоны." />
}
else
{
    <AppPageHeader
        Kicker="Редактор"
        Title="@PageTitleText"
        Subtitle="Настройте структуру, тему и набор виджетов для отображения на дисплеях." />

    <div class="editor-grid">
        <section class="editor-form">
            <div class="field">
                <label>Название шаблона</label>
                <input @bind="templateName" @bind:event="oninput" placeholder="Например: Утренняя сетка" />
            </div>

            <div class="field-row">
                <div class="field">
                    <label>Сетка</label>
                    <select @bind="layout">
                        @foreach (var item in TemplateLayouts.All)
                        {
                            <option value="@item">@TemplateLayouts.GetDisplayName(item)</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label>Тема</label>
                    <select @bind="theme">
                        @foreach (var item in TemplateThemes.All)
                        {
                            <option value="@item">@TemplateThemes.GetDisplayName(item)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="widgets-picker">
                <h2>Виджеты</h2>
                @foreach (var type in WidgetTypes.All)
                {
                    <label class="widget-option">
                        <input type="checkbox" checked="@selectedWidgets.Contains(type)" @onchange="args => ToggleWidget(type, args)" />
                        <span>
                            <strong>@WidgetTypes.GetDisplayName(type)</strong>
                            <small>@GetWidgetDescription(type)</small>
                        </span>
                    </label>
                }
            </div>

            <div class="editor-actions">
                <button type="button" @onclick="SaveAsync">Сохранить</button>
                <button type="button" class="secondary" @onclick="Back">Назад</button>
            </div>
        </section>

        <section class="editor-preview">
            <TemplatePreviewFrame Template="PreviewTemplate" Size="compact" />
        </section>
    </div>
}

@code {
    [Parameter] public string? TemplateId { get; set; }

    private string templateName = "Новый шаблон";
    private string layout = TemplateLayouts.Grid;
    private string theme = TemplateThemes.Light;
    private List<string> selectedWidgets = new() { WidgetTypes.News, WidgetTypes.Parking };

    private string PageTitleText => string.IsNullOrWhiteSpace(TemplateId) ? "Создание шаблона" : "Редактирование шаблона";

    private TemplateDto PreviewTemplate
    {
        get
        {
            var widgets = selectedWidgets
                .Select((type, index) => TemplateWidgetDto.Create(type, index + 1))
                .ToList();

            var config = new TemplateConfigDto
            {
                Layout = layout,
                Theme = theme
            };

            config.SetWidgetItems(widgets);

            return new TemplateDto
            {
                Id = TemplateId ?? "new-template",
                Name = templateName,
                Config = config
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated || string.IsNullOrWhiteSpace(TemplateId))
        {
            return;
        }

        var template = await TemplatesService.GetTemplateByIdAsync(TemplateId);
        if (template is null)
        {
            return;
        }

        templateName = template.Name;
        layout = template.Config.Layout;
        theme = template.Config.Theme;
        selectedWidgets = template.Config.GetEffectiveWidgets().Select(widget => widget.Type).ToList();
    }

    private void ToggleWidget(string type, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;

        if (isChecked && !selectedWidgets.Contains(type))
        {
            selectedWidgets.Add(type);
        }

        if (!isChecked)
        {
            selectedWidgets.Remove(type);
        }
    }

    private async Task SaveAsync()
    {
        var config = PreviewTemplate.Config;

        if (string.IsNullOrWhiteSpace(TemplateId))
        {
            await TemplatesService.CreateTemplateAsync(new CreateTemplateRequest
            {
                Name = templateName,
                Config = config
            });
        }
        else
        {
            await TemplatesService.UpdateTemplateAsync(TemplateId, new UpdateTemplateRequest
            {
                Name = templateName,
                Config = config
            });
        }

        Navigation.NavigateTo("/templates");
    }

    private void Back() => Navigation.NavigateTo("/templates");

    private static string GetWidgetDescription(string type)
    {
        return type switch
        {
            WidgetTypes.News => "Новости, объявления и публикации УК.",
            WidgetTypes.Parking => "Количество свободных машиномест по зонам.",
            WidgetTypes.Storage => "Доступные кладовые помещения.",
            WidgetTypes.StaticText => "Правила ЖК, контакты и постоянная информация.",
            WidgetTypes.Weather => "Погода и температура возле ЖК.",
            WidgetTypes.Rss => "Внешняя лента района или города.",
            WidgetTypes.Camera => "Видеопоток общедомовой камеры.",
            _ => "Информационный блок дисплея."
        };
    }
}
