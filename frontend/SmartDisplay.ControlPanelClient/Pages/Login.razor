@page "/login"

@using SmartDisplay.ControlPanelClient.Models.Auth
@using SmartDisplay.ControlPanelClient.Services.Auth

@inject IAuthService AuthService
@inject AuthState AuthState
@inject ITokenStorageService TokenStorage
@inject NavigationManager Navigation

<PageTitle>Smart display | Login</PageTitle>

<main class="login-page">
    <div class="login-shade" aria-hidden="true"></div>

    <section class="login-panel" aria-label="Форма авторизации Smart display">
        <div class="login-brand" aria-label="Ujin Smart display">
            <div class="ujin-logo" aria-hidden="true">
                <span class="ujin-mark">U</span>
                <span class="ujin-text">ujin</span>
            </div>
            <div class="smart-display-title">Smart display</div>
        </div>

        <div class="login-form">
            <input class="login-input"
                   aria-label="Username"
                   autocomplete="username"
                   placeholder="Username"
                   @bind="loginModel.Username"
                   @bind:event="oninput" />

            <input class="login-input"
                   aria-label="Password"
                   type="password"
                   autocomplete="current-password"
                   placeholder="Password"
                   @bind="loginModel.Password"
                   @bind:event="oninput"
                   @onkeydown="HandlePasswordKeyDown" />

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="login-error">@errorMessage</div>
            }

            <button class="login-button" type="button" disabled="@isLoading" @onclick="LoginAsync">
                @(isLoading ? "Loading..." : "Log in")
            </button>

            <a class="contact-link" href="mailto:support@ujin.tech">Contact us</a>
        </div>
    </section>

    <div class="login-caption">
        Цифровые решения для умных<br />
        зданий и домов
    </div>
</main>

@code {
    private readonly LoginRequest loginModel = new();
    private bool isLoading;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            var savedSession = await TokenStorage.LoadSessionAsync();
            if (savedSession is not null)
            {
                AuthState.RestoreSession(savedSession);
            }
        }

        if (AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }

    private async Task LoginAsync()
    {
        if (isLoading)
        {
            return;
        }

        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Enter username and password.";
            return;
        }

        isLoading = true;

        try
        {
            var response = await AuthService.LoginAsync(loginModel);

            if (!response.HasAccessToken)
            {
                errorMessage = "Invalid username or password.";
                return;
            }

            Navigation.NavigateTo("/dashboard");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePasswordKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await LoginAsync();
        }
    }
}
