@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="foundRouteData">
        <RouteView RouteData="@foundRouteData" />
    </Found>
    <NotFound>
        <main class="screen-page screen-message">
            <h1>Экран не найден</h1>
            <p>Проверьте адрес дисплея.</p>
        </main>
    </NotFound>
</Router>
